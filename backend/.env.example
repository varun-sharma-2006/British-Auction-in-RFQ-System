# PostgreSQL connection string. postgres:// and postgresql:// URLs are accepted too.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/british_auction

# Sign-in tokens are signed with this. Use a long random value anywhere real.
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of origins allowed to call the API (only needed when the UI is on another origin)
CORS_ORIGINS=http://localhost:5173

# How often (seconds) auctions whose close time has passed are closed
CLOSER_INTERVAL_SECONDS=2

# Optional: Redis for Celery + multi-replica live updates. When set, run the Celery worker/beat
# and set RUN_CLOSER=false so the API doesn't also run the closer.
# REDIS_URL=redis://localhost:6379/0
# RUN_CLOSER=false

# Optional: serve the built frontend from the API (single-container mode)
# FRONTEND_DIST=../frontend/dist
